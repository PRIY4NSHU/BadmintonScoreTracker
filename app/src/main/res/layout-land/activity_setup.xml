<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/formSection"
            app:layout_constraintHorizontal_chainStyle="packed">

            <ImageView
                android:id="@+id/shuttlecockIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/shuttlecock"
                android:layout_marginBottom="8dp"
                android:contentDescription="Shuttlecock"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Badminton"
                android:fontFamily="@font/playfair_display_bold"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score Keeper"
                android:fontFamily="@font/lato_regular"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <!-- Form Section -->
        <LinearLayout
            android:id="@+id/formSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/startGameBtn"
            app:layout_constraintStart_toEndOf="@+id/headerSection"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Players Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Name"
                            android:fontFamily="@font/lato_regular"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/input_stroke"
                            app:boxBackgroundColor="@color/input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/playerNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="You"
                                android:inputType="textPersonName"
                                android:textSize="14sp"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Opponent Name"
                            android:fontFamily="@font/lato_regular"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/input_stroke"
                            app:boxBackgroundColor="@color/input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/opponentNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Opponent"
                                android:inputType="textPersonName"
                                android:textSize="14sp"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Target Score Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLAY TO"
                        android:fontFamily="@font/lato_bold"
                        android:textSize="11sp"
                        android:textColor="@color/accent_green"
                        android:letterSpacing="0.1"
                        android:layout_marginEnd="16dp"/>

                    <RadioGroup
                        android:id="@+id/targetScoreGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/score11"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="11"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/radio_score_bg"
                            android:fontFamily="@font/playfair_display_bold"
                            android:textSize="14sp"
                            android:textColor="@color/radio_text_selector"
                            android:layout_marginEnd="6dp"/>

                        <RadioButton
                            android:id="@+id/score15"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="15"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/radio_score_bg"
                            android:fontFamily="@font/playfair_display_bold"
                            android:textSize="14sp"
                            android:textColor="@color/radio_text_selector"
                            android:layout_marginEnd="6dp"/>

                        <RadioButton
                            android:id="@+id/score21"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="21"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/radio_score_bg"
                            android:fontFamily="@font/playfair_display_bold"
                            android:textSize="14sp"
                            android:textColor="@color/radio_text_selector"
                            android:checked="true"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Start Button -->
        <Button
            android:id="@+id/startGameBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Start Game"
            android:fontFamily="@font/lato_bold"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/btn_primary_bg"
            app:layout_constraintTop_toBottomOf="@+id/formSection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/formSection"
            app:layout_constraintEnd_toEndOf="@+id/formSection"
            android:stateListAnimator="@null"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>