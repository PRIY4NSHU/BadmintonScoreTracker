<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Background watermark (smaller for landscape) -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_shuttlecock_bg"
        android:alpha="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="decorative"/>

    <!-- Toolbar (Compact) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_primary"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center divider -->
    <View
        android:id="@+id/centerDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <!-- Player side -->
    <LinearLayout
        android:id="@+id/player1Section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/player_side_bg"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toStartOf="@+id/centerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <TextView
            android:id="@+id/playerNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You"
            android:fontFamily="@font/lato_bold"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/myServeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVE"
            android:fontFamily="@font/lato_bold"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:background="@drawable/serve_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="2dp"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/myScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="@font/playfair_display_bold"
            android:textStyle="bold"
            android:textSize="72sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false" />

        <Button
            android:id="@+id/myPointBtn"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="+ Point"
            android:fontFamily="@font/lato_bold"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/btn_player_bg"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Opponent side -->
    <LinearLayout
        android:id="@+id/player2Section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/centerDivider"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <TextView
            android:id="@+id/opponentNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opponent"
            android:fontFamily="@font/lato_bold"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/opponentServeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVE"
            android:fontFamily="@font/lato_bold"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:background="@drawable/serve_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="2dp"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/opponentScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:fontFamily="@font/playfair_display_bold"
            android:textStyle="bold"
            android:textSize="72sp"
            android:textColor="@color/text_primary"
            android:includeFontPadding="false" />

        <Button
            android:id="@+id/opponentPointBtn"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="+ Point"
            android:fontFamily="@font/lato_bold"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/btn_opponent_bg"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Bottom action bar (Compact for landscape) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/card_bg"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/undoBtn"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:text="↩ Undo"
            android:fontFamily="@font/lato_bold"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary_bg"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/resetBtn"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:text="Reset"
            android:fontFamily="@font/lato_bold"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary_bg"
            android:stateListAnimator="@null"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Winner overlay -->
    <FrameLayout
        android:id="@+id/winnerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC1A2E1A"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFD166">

                <ImageView
                    android:id="@+id/trophyIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/trophy"
                    android:scaleType="centerInside"
                    android:contentDescription="trophy"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/winnerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_bold"
                android:textStyle="bold"
                android:textSize="32sp"
                android:textColor="@color/white"
                android:gravity="center"/>

            <TextView
                android:id="@+id/winnerScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:textSize="18sp"
                android:textColor="#CCFFFFFF"
                android:gravity="center"/>

        </LinearLayout>

    </FrameLayout>

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>