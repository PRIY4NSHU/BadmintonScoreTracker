<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- Shuttlecock icon placeholder (use your drawable) -->
        <ImageView
            android:id="@+id/shuttlecockIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/shuttlecock"
            android:layout_marginBottom="12dp"
            android:contentDescription="Shuttlecock"/>

        <!-- App title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badminton"
            android:fontFamily="@font/playfair_display_bold"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score Keeper"
            android:fontFamily="@font/lato_regular"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:layout_marginBottom="44dp"/>

        <!-- Card container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYERS"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="11sp"
                    android:textColor="@color/accent_green"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="16dp"/>

                <!-- Player name field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your name"
                    android:fontFamily="@font/lato_regular"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxBackgroundColor="@color/input_bg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/playerNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="You"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/lato_regular"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Opponent name field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opponent name"
                    android:fontFamily="@font/lato_regular"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/input_stroke"
                    app:boxBackgroundColor="@color/input_bg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/opponentNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Opponent"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/lato_regular"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Target score card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY TO"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="11sp"
                    android:textColor="@color/accent_green"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:id="@+id/targetScoreGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/score11"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="11"
                        android:gravity="center"
                        android:button="@null"
                        android:background="@drawable/radio_score_bg"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/radio_text_selector"
                        android:layout_marginEnd="8dp"/>

                    <RadioButton
                        android:id="@+id/score15"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="15"
                        android:gravity="center"
                        android:button="@null"
                        android:background="@drawable/radio_score_bg"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/radio_text_selector"
                        android:layout_marginEnd="8dp"/>

                    <RadioButton
                        android:id="@+id/score21"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="21"
                        android:gravity="center"
                        android:button="@null"
                        android:background="@drawable/radio_score_bg"
                        android:fontFamily="@font/playfair_display_bold"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/radio_text_selector"
                        android:checked="true"/>

                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Start Game button -->
        <Button
            android:id="@+id/startGameBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Start Game"
            android:fontFamily="@font/lato_bold"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:letterSpacing="0.06"
            android:background="@drawable/btn_primary_bg"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>